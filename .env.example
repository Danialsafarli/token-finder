# All optional. The app works with zero keys using DexScreener + Jupiter + RugCheck.

# Helius (https://helius.dev) - on-chain mint authority + holder concentration
HELIUS_API_KEY=

# Birdeye (https://birdeye.so) - new listings feed + richer overview data
BIRDEYE_API_KEY=

# Dashboard
PORT=5173

# Monitor tuning
SCAN_INTERVAL_SEC=120
MIN_LIQUIDITY_USD=3000
MAX_AGE_HOURS=168
MIN_SCORE_ALERT=70
MIN_COVERAGE_ALERT=0.6

# Ranking eligibility. Not calibrated against outcome data - tune deliberately.
MIN_COVERAGE_QUALIFY=0.6
MIN_COVERAGE_WATCH=0.35
# Top-holder share that hard-vetoes rather than penalising.
CATASTROPHIC_CONCENTRATION_PCT=90

# Where runtime state lives, relative to the repo root. Point a smoke run at a
# scratch directory so it cannot pollute your collected data.
# TOKEN_FINDER_DATA_DIR=data

# ---------------------------------------------------------------------------
# TypeSafe / Jev - optional advisory impersonation screening
#
# Server-side only. Never expose this key to the browser: nothing under
# src/server/public reads config, and /api/status reports booleans only.
#
# Both of the following are required for screening to run. With either missing,
# every token records "not assessed" - which is NOT a clean bill of health.
# ---------------------------------------------------------------------------
TYPESAFE_API_KEY=
TYPESAFE_ENABLED=false

# Model id; see https://docs.typesafe.ai/models
TYPESAFE_MODEL=jev-latest
# Hard cap on model requests per scan.
TYPESAFE_MAX_PER_SCAN=10
TYPESAFE_TIMEOUT_MS=8000

# ---------------------------------------------------------------------------
# Persistence (SQLite)
#
# The database lives inside the data directory, which TOKEN_FINDER_DATA_DIR
# already controls. Only the FILENAME is configurable here: path separators,
# `..` and drive prefixes are rejected, so the database cannot be pointed at a
# tracked source file. See PERSISTENCE.md.
# ---------------------------------------------------------------------------
TOKEN_FINDER_DB_FILE=token-finder.sqlite

# When a re-scan is worth a new history row. Defaults keep a two-minute scan
# loop from writing ~700 identical rows per token per day. A state transition
# is ALWAYS recorded regardless of these, and is never pruned.
SNAPSHOT_SCORE_DELTA=1
SNAPSHOT_RELATIVE_DELTA=0.02
SNAPSHOT_COVERAGE_DELTA=0.05
SNAPSHOT_HEARTBEAT_MIN=30

# Retention. Conservative by default: storage is cheap, destroyed history is
# gone. State transitions are never deleted, whatever these say.
RETENTION_HISTORY_DAYS=90
RETENTION_TOKEN_DAYS=180
RETENTION_DIAGNOSTICS_DAYS=14
