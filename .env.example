BIRDEYE_API_KEY=

# Dashboard
PORT=5173

# Monitor tuning
SCAN_INTERVAL_SEC=120
MIN_LIQUIDITY_USD=3000
MAX_AGE_HOURS=168
MIN_SCORE_ALERT=70
